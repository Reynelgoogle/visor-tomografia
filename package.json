{
  "name": "visor-tomografia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dicom-parser": "^1.8.21",
    "express": "^4.21.2",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "main": "electron/main.cjs",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.reynelgoogle.visor-tomografia",
    "productName": "Visor de Tomografía",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "artifactName": "${productName}-Windows-Portable-${version}.${ext}"
    }
  },
  "description": "Visor de tomografía DICOM con MPR multiplanar y reconstrucción volumétrica 3D por GPU.",
  "author": "Reynelgoogle"
}
