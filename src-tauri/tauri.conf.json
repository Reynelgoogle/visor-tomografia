{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "minHeight": 700,
        "minWidth": 1024,
        "resizable": true,
        "title": "Visor de Tomografía",
        "width": 1400
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false
  },
  "identifier": "com.reynelgoogle.visor-tomografia",
  "productName": "Visor de Tomografía",
  "version": "1.0.0"
}
